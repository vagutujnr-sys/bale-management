# Copy to .env and provide values from Supabase Project Settings > API.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy public key if the project does not use publishable keys.
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-side Supabase URL. Local development falls back to VITE_SUPABASE_URL.
SUPABASE_URL=

# Server-only privileged key. Never prefix with VITE_ or expose to browser code.
SUPABASE_SECRET_KEY=

# Optional legacy service_role key; server-only and bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string for local database administration and schema work.
# Contains a database password; keep it private and never prefix with VITE_.
SUPABASE_DB_URL=
